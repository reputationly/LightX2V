# LightX2V ARM64 App 层 — 仅更新 Python 代码，不重新编译 C++ 扩展
# 用途：代码迭代时快速重建（~10 秒），基础镜像不变
#
# 前提：已有 arronlee/lightx2v:arm64-cu128（或本地 lightx2v-arm64:local）
# 用法：
#   docker build -f dockerfiles/Dockerfile_aarch64_app \
#                --build-arg BASE_IMAGE=lightx2v-arm64:ltx \
#                -t lightx2v-arm64:app .
#   docker run --gpus all --network host \
#     -v /shared/models:/shared/models:ro \
#     -v /data/outputs:/data/outputs \
#     lightx2v-arm64:app \
#     python -m lightx2v.server --host 0.0.0.0 --port 8000
#
# 多卡 ulysses 再改用 torchrun:
#   torchrun --nproc_per_node=4 -m lightx2v.server --host 0.0.0.0 --port 8000

ARG BASE_IMAGE=arronlee/lightx2v:arm64-cu128
FROM ${BASE_IMAGE}

# 只替换 LightX2V Python 代码，不碰已编译的 flash_attn / SageAttention
COPY . /opt/LightX2V
RUN pip install --no-cache-dir -e /opt/LightX2V --no-deps

# gpustack-lx2v-launcher: front proxy + profile-driven engine spawner used by
# GPUStack's LightX2V built-in backend (occupies {{port}}, self-answers /ready,
# spawns python -m lightx2v.server / torchrun per profile). Source lives in the
# repo at deploy/gpustack-lx2v-launcher/ (copied in above via `COPY .`).
RUN printf '#!/bin/sh\nexec python /opt/LightX2V/deploy/gpustack-lx2v-launcher/gpustack_lx2v_launcher.py "$@"\n' \
      > /usr/local/bin/gpustack-lx2v-launcher \
 && chmod +x /usr/local/bin/gpustack-lx2v-launcher \
 && python -m py_compile /opt/LightX2V/deploy/gpustack-lx2v-launcher/gpustack_lx2v_launcher.py

# ⚠ 顺序要紧:decord 垫片必须排在 /opt/LightX2V 之前。
#   - cu130 base(Dockerfile_aarch64_cu130)在 /opt/decord_shim 提供 PyAV 版 decord;
#     aarch64 上 PyPI 的 decord 既无 wheel 也无 sdist,只能用垫片。
#   - 旧 cu128 base 没有该目录,PYTHONPATH 里含不存在的路径无害,故两条 base 线通用。
#   - 别退化成 ENV PYTHONPATH=/opt/LightX2V:会覆盖 base 的设置,使垫片失效。
#   - /opt/LightX2V 下若有构建残留的空 decord 目录,会作为 namespace package 劫持
#     import(属性数 0、调用即崩、还让 try/except fallback 失效),所以顺带删掉。
RUN rm -rf /opt/LightX2V/decord
ENV PYTHONPATH=/opt/decord_shim:/opt/LightX2V
WORKDIR /workspace
CMD ["/bin/bash"]
